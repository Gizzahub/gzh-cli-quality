# AI Tools
.serena/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html

# Benchmark results
bench.txt
bench-new.txt

# Build directory
build/
dist/
bin/

# Go workspace file
# (tracked) keep repo-local go.work to avoid inheriting parent workspaces

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
*.tmp
*.log

# CE task runtime: track only the root declaration. ~/.gitignore_global ignores
# .ce/, so the root directory is re-included and its other contents re-ignored.
!/.ce/
/.ce/*
!/.ce/task-runtime.yaml

# Task cards live in the gzh-cli-devbox board (user decision 2026-11-18).
/tasks/
